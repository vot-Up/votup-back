# votup-back — Environment Variables
# Copy this file to votup.conf and fill in the values.
# The app loads votup.conf via python-dotenv (see votup/settings.py).

# ── Database ──────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votup
DB_USER=postgres
DB_PASS=

# ── Minio / S3 Storage ───────────────────────────────────
# Must match docker-compose.yml MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
AWS_ACCESS_KEY_ID=miniovotup
AWS_SECRET_ACCESS_KEY=miniovotup
AWS_STORAGE_BUCKET_NAME=votup
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ── Jasper Reports (optional) ────────────────────────────
JASPER_HOST=http://localhost:8089/jasperserver/rest_v2/reports/Reports/
JASPER_USER=votup
JASPER_PASS=

# ── Deploy paths (optional) ──────────────────────────────
SOURCE_DEPLOY=/usr/app/reports
SOURCE_LOCAL=/usr/app/reports
